# Copy to .env and edit. Never commit .env.
# All settings are optional; defaults work for a local run.
MONSOON_REQUEST_TIMEOUT_S=10
MONSOON_MAX_RETRIES=2
MONSOON_FORECAST_STALE_HOURS=12
MONSOON_CONNECTIVITY_HOST=api.open-meteo.com
# Only needed if you later add a key-based provider (e.g. an IMD data-request account).
# The names below are placeholders, no real provider currently reads them.
MONSOON_IMD_API_KEY=your-key-here
