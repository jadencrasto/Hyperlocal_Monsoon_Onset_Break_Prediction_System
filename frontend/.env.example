# ---------------------------------------------------------------------------
# Frontend environment variables — copy to .env.local for local overrides.
# Do NOT commit .env.local or any file containing real secrets/URLs.
# ---------------------------------------------------------------------------

# Optional: absolute base URL of the backend API (no trailing slash).
# Leave unset (or empty) for local development — the Vite dev-server proxy
# will forward all /api/* requests to http://127.0.0.1:8000 automatically.
#
# Set this in your Vercel project settings (Environment Variables) when
# deploying the frontend separately from the backend, e.g.:
#   VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
#
VITE_API_BASE_URL=
